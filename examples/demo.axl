// Sums the first n numbers of a shared buffer.
fn total(data: buf_u64, n: u64) -> u64 ![mem] {
    var i = 0u64;
    var sum = 0u64;
    while i < n {
        sum = sum + buf_get(data, i);
        i = i + 1u64;
    }
    return sum;
}

fn average(data: buf_u64, n: u64) -> u64 ![mem] {
    return total(data, n) / n;
}

fn double(x: u64) -> u64 nothrow noalloc { return x * 2u64; }

fn report(label: u64, value: u64) -> unit ![io, mem] {
    print(label);
    print(value);
}

fn main() -> unit ![io, mem] {
    let data = buf_iota(10u64);
    let alias = data;
    buf_set(alias, 0u64, double(21u64));
    report(1u64, average(data, 10u64));
}
